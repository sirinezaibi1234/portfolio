# Copy to `.env.local`. All variables are optional; the site builds without them.

# Your live domain, no trailing slash. Drives the sitemap, canonical URL and
# Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Contact form endpoint (free Formspree form: https://formspree.io).
# Leave empty and the form opens the visitor's email app instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id

# Optional Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
